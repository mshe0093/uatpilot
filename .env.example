# Claude API key: needed for `uatpilot generate` and for Claude triage. Without it, triage uses
# the deterministic rules engine and generation is disabled.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# UATPILOT_MODEL=claude-opus-5-5
# UATPILOT_EFFORT=medium
# UATPILOT_ENGINE=auto            # auto | claude | rules
# UATPILOT_DB=data/uatpilot.db
# UATPILOT_ARTIFACTS=data/artifacts
# UATPILOT_ALLOWED_HOSTS=restful-booker.herokuapp.com,www.saucedemo.com,localhost,127.0.0.1
# UATPILOT_MIN_REQUEST_INTERVAL=0.3
# UATPILOT_WRITE_TOKEN=           # set on public deployments: visitors become read-only
# UATPILOT_WRITE_LIMIT_PER_HOUR=20
# UATPILOT_CORS_ORIGINS=http://localhost:3000
