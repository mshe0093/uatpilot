# Copy to .env (git-ignored) and fill in ONE model key. Without any key, triage falls back to the
# deterministic rules engine and generation is disabled.

# --- Free options (no card needed) -----------------------------------------------------------
# Google Gemini: https://aistudio.google.com/apikey  (default model gemini-3.5-flash)
#   Note: on the free tier Google may use prompts to improve its models; only send sandbox data.
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys                (default model llama-3.3-70b-versatile)
# GROQ_API_KEY=
# OpenRouter: https://openrouter.ai/keys             (default model meta-llama/llama-3.3-70b-instruct:free)
# OPENROUTER_API_KEY=
# GitHub Models: uses your `gh` login; select it with UATPILOT_PROVIDER=github   (default openai/gpt-4.1)
# GITHUB_TOKEN=

# --- Paid -------------------------------------------------------------------------------------
# ANTHROPIC_API_KEY=                                  (default model claude-opus-5-5)

# Optional overrides (defaults shown)
# UATPILOT_PROVIDER=                # anthropic | gemini | groq | openrouter | github (auto-detected from the key, except github)
# UATPILOT_MODEL=                   # provider default if empty
# UATPILOT_LLM_BASE_URL=            # any other OpenAI-compatible endpoint
# UATPILOT_EFFORT=medium            # Claude only
# UATPILOT_ENGINE=auto              # auto | llm | rules
# UATPILOT_DB=data/uatpilot.db
# UATPILOT_ARTIFACTS=data/artifacts
# UATPILOT_ALLOWED_HOSTS=restful-booker.herokuapp.com,www.saucedemo.com,localhost,127.0.0.1
# UATPILOT_MIN_REQUEST_INTERVAL=0.3
# UATPILOT_WRITE_TOKEN=             # set on public deployments: visitors become read-only
# UATPILOT_WRITE_LIMIT_PER_HOUR=20
# UATPILOT_CORS_ORIGINS=http://localhost:3000
