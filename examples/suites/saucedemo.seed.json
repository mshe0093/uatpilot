 "test_cases": [
  {
   "title": "Valid customer login lands on the Products page",
   "requirement_ref": "AC-1.1",
   "priority": "high",
   "preconditions": [],
   "steps": [
    "Open the shop",
    "Enter username standard_user and password secret_sauce",
    "Press Login"
   ],
   "expected_result": "The products page opens and shows the heading 'Products'.",
   "executable": {
    "kind": "ui",
    "steps": [
     {
      "action": "goto",
      "value": "/"
     },
     {
      "action": "fill",
      "selector": "#user-name",
      "value": "standard_user"
     },
     {
      "action": "fill",
      "selector": "#password",
      "value": "secret_sauce"
     },
     {
      "action": "click",
      "selector": "#login-button"
     },
     {
      "action": "expect_url",
      "value": "/inventory.html"
     },
     {
      "action": "expect_text",
      "selector": "[data-test=\"title\"]",
      "value": "Products"
     }
    ]
   }
  },
  {
   "title": "Locked-out account cannot log in and sees a locked-out message",
   "requirement_ref": "AC-1.2",
   "priority": "high",
   "preconditions": [],
   "steps": [
    "Open the shop",
    "Enter username locked_out_user and password secret_sauce",
    "Press Login"
   ],
   "expected_result": "The customer stays on the login page and sees a 'locked out' error.",
   "executable": {
    "kind": "ui",
    "steps": [
     {
      "action": "goto",
      "value": "/"
     },
     {
      "action": "fill",
      "selector": "#user-name",
      "value": "locked_out_user"
     },
     {
      "action": "fill",
      "selector": "#password",
      "value": "secret_sauce"
     },
     {
      "action": "click",
      "selector": "#login-button"
     },
     {
      "action": "expect_text",
      "selector": "[data-test=\"error\"]",
      "value": "locked out"
     },
     {
      "action": "expect_visible",
      "selector": "#login-button"
     }
    ]
   }
  },
