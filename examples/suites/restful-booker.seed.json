{
  "requirements": "../requirements/restful-booker.md",
  "target_kind": "api",
  "base_url": "https://restful-booker.herokuapp.com",
  "note": "Hand-written by a human as a fixture for the runner, triage and dashboard. NOT generated by the agent. Used for offline demos and CI; the agent's own suites come from `uatpilot generate`.",
  "test_cases": [
    {
      "title": "Health check endpoint reports the service is up",
      "requirement_ref": "AC-1.1",
      "steps": ["Send GET /ping"],
      "expected_result": "A 2xx success status is returned.",
      "priority": "high",
      "executable": {"kind": "api", "steps": [
        {"name": "ping", "method": "GET", "path": "/ping",
         "assertions": [{"source": "status_code", "op": "less_than", "expected": 300},
                        {"source": "status_code", "op": "greater_than", "expected": 199}]}
      ]}
    },
    {
      "title": "Create a complete booking and get it echoed back with an id",
      "requirement_ref": "AC-2.1",
      "steps": ["Send POST /booking with a complete valid booking for guest Ada Lovelace"],
      "expected_result": "200 OK with a numeric booking id and every field echoed back unchanged.",
      "priority": "high",
      "executable": {"kind": "api", "steps": [
        {"name": "create booking", "method": "POST", "path": "/booking",
         "headers": [{"name": "Accept", "value": "application/json"}],
         "json_body": {"firstname": "Ada", "lastname": "Lovelace", "totalprice": 250, "depositpaid": true,
                       "bookingdates": {"checkin": "2026-12-01", "checkout": "2026-12-04"}, "additionalneeds": "Late checkout"},
         "assertions": [
           {"source": "status_code", "op": "equals", "expected": 200},
           {"source": "json", "path": "bookingid", "op": "type_is", "expected": "integer"},
           {"source": "json", "path": "booking.firstname", "op": "equals", "expected": "Ada"},
           {"source": "json", "path": "booking.lastname", "op": "equals", "expected": "Lovelace"},
           {"source": "json", "path": "booking.totalprice", "op": "equals", "expected": 250},
           {"source": "json", "path": "booking.depositpaid", "op": "equals", "expected": true},
           {"source": "json", "path": "booking.bookingdates.checkin", "op": "equals", "expected": "2026-12-01"},
           {"source": "json", "path": "booking.additionalneeds", "op": "equals", "expected": "Late checkout"}]}
      ]}
    },
    {
      "title": "A new booking can be fetched straight away with the same details",
      "requirement_ref": "AC-2.2",
      "steps": ["Create a booking for guest Grace Hopper", "Fetch it by the returned booking id"],
      "expected_result": "The fetched booking shows the same name, price and dates.",
      "priority": "high",
      "executable": {"kind": "api", "steps": [
        {"name": "create booking", "method": "POST", "path": "/booking",
         "headers": [{"name": "Accept", "value": "application/json"}],
         "json_body": {"firstname": "Grace", "lastname": "Hopper", "totalprice": 180, "depositpaid": false,
                       "bookingdates": {"checkin": "2026-11-20", "checkout": "2026-11-22"}},
         "assertions": [{"source": "status_code", "op": "equals", "expected": 200}],
         "capture": [{"name": "booking_id", "value": "bookingid"}]},
        {"name": "fetch booking", "method": "GET", "path": "/booking/{{booking_id}}",
         "headers": [{"name": "Accept", "value": "application/json"}],
         "assertions": [
           {"source": "status_code", "op": "equals", "expected": 200},
           {"source": "json", "path": "firstname", "op": "equals", "expected": "Grace"},
           {"source": "json", "path": "totalprice", "op": "equals", "expected": 180},
           {"source": "json", "path": "bookingdates.checkout", "op": "equals", "expected": "2026-11-22"}]}
      ]}
    },
    {
      "title": "A booking with missing required fields is rejected with 400",
      "requirement_ref": "AC-2.3",
      "steps": ["Send POST /booking with only a first name"],
      "expected_result": "400 Bad Request (not accepted, not a server error).",
      "priority": "high",
      "executable": {"kind": "api", "steps": [
        {"name": "create incomplete booking", "method": "POST", "path": "/booking",
         "headers": [{"name": "Accept", "value": "application/json"}],
         "json_body": {"firstname": "OnlyAFirstName"},
         "assertions": [{"source": "status_code", "op": "equals", "expected": 400}]}
      ]}
    },
    {
      "title": "A booking with a negative total price is rejected",
      "requirement_ref": "AC-2.4",
      "steps": ["Send POST /booking with totalprice -50"],
      "expected_result": "A 4xx client error; no booking is created.",
      "priority": "medium",
      "executable": {"kind": "api", "steps": [
        {"name": "create negative price booking", "method": "POST", "path": "/booking",
         "headers": [{"name": "Accept", "value": "application/json"}],
         "json_body": {"firstname": "Neg", "lastname": "Price", "totalprice": -50, "depositpaid": true,
                       "bookingdates": {"checkin": "2026-12-01", "checkout": "2026-12-02"}},
         "assertions": [{"source": "status_code", "op": "greater_than", "expected": 399},
                        {"source": "status_code", "op": "less_than", "expected": 500}]}
      ]}
    },
    {
      "title": "A booking that checks out before it checks in is rejected",
      "requirement_ref": "AC-2.5",
      "steps": ["Send POST /booking with checkout 2026-12-01 and checkin 2026-12-05"],
      "expected_result": "A 4xx client error; no booking is created.",
      "priority": "medium",
      "executable": {"kind": "api", "steps": [
        {"name": "create reversed dates booking", "method": "POST", "path": "/booking",
         "headers": [{"name": "Accept", "value": "application/json"}],
         "json_body": {"firstname": "Back", "lastname": "Wards", "totalprice": 100, "depositpaid": true,
                       "bookingdates": {"checkin": "2026-12-05", "checkout": "2026-12-01"}},
         "assertions": [{"source": "status_code", "op": "greater_than", "expected": 399},
                        {"source": "status_code", "op": "less_than", "expected": 500}]}
      ]}
    },
    {
      "title": "Listing bookings returns an array of booking ids",
      "requirement_ref": "AC-3.1",
      "steps": ["Send GET /booking"],
      "expected_result": "200 OK with a JSON array whose entries each have a booking id.",
      "priority": "medium",
      "executable": {"kind": "api", "steps": [
        {"name": "list bookings", "method": "GET", "path": "/booking",
         "assertions": [
           {"source": "status_code", "op": "equals", "expected": 200},
           {"source": "json", "path": "length()", "op": "greater_than", "expected": 0},
           {"source": "json", "path": "[0].bookingid", "op": "type_is", "expected": "integer"}]}
      ]}
    },
    {
      "title": "Filtering by guest name finds the guest's booking",
      "requirement_ref": "AC-3.2",
      "steps": ["Create a booking for a guest with a distinctive name (Uatpilot Filtertest)",
                "Search bookings by that first and last name"],
      "expected_result": "The search result contains the new booking id.",
      "priority": "medium",
      "executable": {"kind": "api", "steps": [
        {"name": "create booking", "method": "POST", "path": "/booking",
         "headers": [{"name": "Accept", "value": "application/json"}],
         "json_body": {"firstname": "Uatpilot", "lastname": "Filtertest", "totalprice": 99, "depositpaid": true,
                       "bookingdates": {"checkin": "2026-12-10", "checkout": "2026-12-11"}},
         "assertions": [{"source": "status_code", "op": "equals", "expected": 200}],
         "capture": [{"name": "booking_id", "value": "bookingid"}]},
        {"name": "search by name", "method": "GET", "path": "/booking",
         "query": [{"name": "firstname", "value": "Uatpilot"}, {"name": "lastname", "value": "Filtertest"}],
         "assertions": [
           {"source": "status_code", "op": "equals", "expected": 200},
           {"source": "body_text", "op": "contains", "expected": "{{booking_id}}"}]}
      ]}
    },
    {
      "title": "Fetching a booking that does not exist returns 404",
      "requirement_ref": "AC-3.3",
      "steps": ["Send GET /booking/987654321"],
      "expected_result": "404 Not Found.",
      "priority": "medium",
      "executable": {"kind": "api", "steps": [
        {"name": "fetch missing booking", "method": "GET", "path": "/booking/987654321",
         "assertions": [{"source": "status_code", "op": "equals", "expected": 404}]}
      ]}
    },
    {
      "title": "Logging in with the UAT credentials returns a token",
      "requirement_ref": "AC-4.1",
      "steps": ["Send POST /auth with the UAT username and password"],
      "expected_result": "200 OK with a non-empty token.",
      "priority": "high",
      "executable": {"kind": "api", "steps": [
        {"name": "auth valid", "method": "POST", "path": "/auth",
         "json_body": {"username": "admin", "password": "password123"},
         "assertions": [
           {"source": "status_code", "op": "equals", "expected": 200},
           {"source": "json", "path": "token", "op": "matches", "expected": "^\\S{6,}$"}]}
      ]}
    },
    {
      "title": "Logging in with a wrong password is refused with 401 and no token",
      "requirement_ref": "AC-4.2",
      "steps": ["Send POST /auth with the UAT username and a wrong password"],
      "expected_result": "401 Unauthorized and no token in the response.",
      "priority": "high",
      "executable": {"kind": "api", "steps": [
        {"name": "auth wrong password", "method": "POST", "path": "/auth",
         "json_body": {"username": "admin", "password": "not-the-password"},
         "assertions": [
           {"source": "json", "path": "token", "op": "not_exists"},
           {"source": "status_code", "op": "equals", "expected": 401}]}
      ]}
    },
    {
      "title": "Changing or cancelling a booking without logging in is forbidden",
      "requirement_ref": "AC-4.3",
      "steps": ["Create a booking", "Try to replace it without a token", "Try to cancel it without a token"],
      "expected_result": "Both the change and the cancellation return 403 Forbidden.",
      "priority": "high",
      "executable": {"kind": "api", "steps": [
        {"name": "create booking", "method": "POST", "path": "/booking",
         "headers": [{"name": "Accept", "value": "application/json"}],
         "json_body": {"firstname": "No", "lastname": "Token", "totalprice": 10, "depositpaid": false,
                       "bookingdates": {"checkin": "2026-12-01", "checkout": "2026-12-02"}},
         "assertions": [{"source": "status_code", "op": "equals", "expected": 200}],
         "capture": [{"name": "booking_id", "value": "bookingid"}]},
        {"name": "put without token", "method": "PUT", "path": "/booking/{{booking_id}}",
         "headers": [{"name": "Accept", "value": "application/json"}],
         "json_body": {"firstname": "Hacked", "lastname": "Token", "totalprice": 1, "depositpaid": false,
                       "bookingdates": {"checkin": "2026-12-01", "checkout": "2026-12-02"}},
         "assertions": [{"source": "status_code", "op": "equals", "expected": 403}]},
        {"name": "delete without token", "method": "DELETE", "path": "/booking/{{booking_id}}",
         "assertions": [{"source": "status_code", "op": "equals", "expected": 403}]}
      ]}
    },
    {
      "title": "Replacing a booking with PUT updates every field",
      "requirement_ref": "AC-5.1",
      "steps": ["Log in", "Create a booking", "Replace it with new name, price and deposit values",
                "Fetch it again"],
      "expected_result": "The update returns 200 and the fetched booking shows only the new values.",
      "priority": "high",
      "executable": {"kind": "api", "steps": [
        {"name": "auth", "method": "POST", "path": "/auth",
         "json_body": {"username": "admin", "password": "password123"},
         "assertions": [{"source": "status_code", "op": "equals", "expected": 200}],
         "capture": [{"name": "token", "value": "token"}]},
        {"name": "create booking", "method": "POST", "path": "/booking",
         "headers": [{"name": "Accept", "value": "application/json"}],
         "json_body": {"firstname": "Old", "lastname": "Name", "totalprice": 100, "depositpaid": true,
                       "bookingdates": {"checkin": "2026-12-01", "checkout": "2026-12-03"}, "additionalneeds": "Breakfast"},
         "assertions": [{"source": "status_code", "op": "equals", "expected": 200}],
         "capture": [{"name": "booking_id", "value": "bookingid"}]},
        {"name": "replace booking", "method": "PUT", "path": "/booking/{{booking_id}}",
         "headers": [{"name": "Accept", "value": "application/json"}, {"name": "Cookie", "value": "token={{token}}"}],
         "json_body": {"firstname": "New", "lastname": "Name", "totalprice": 300, "depositpaid": false,
                       "bookingdates": {"checkin": "2026-12-01", "checkout": "2026-12-03"}},
         "assertions": [
           {"source": "status_code", "op": "equals", "expected": 200},
           {"source": "json", "path": "firstname", "op": "equals", "expected": "New"},
           {"source": "json", "path": "totalprice", "op": "equals", "expected": 300}]},
        {"name": "fetch replaced booking", "method": "GET", "path": "/booking/{{booking_id}}",
         "headers": [{"name": "Accept", "value": "application/json"}],
         "assertions": [
           {"source": "status_code", "op": "equals", "expected": 200},
           {"source": "json", "path": "depositpaid", "op": "equals", "expected": false},
           {"source": "json", "path": "additionalneeds", "op": "not_exists"}]}
      ]}
    },
    {
      "title": "Patching only the first name leaves the rest of the booking unchanged",
      "requirement_ref": "AC-5.2",
      "steps": ["Log in", "Create a booking", "Change only the first name", "Check the response"],
      "expected_result": "The first name is changed; last name, price and dates are unchanged.",
      "priority": "medium",
      "executable": {"kind": "api", "steps": [
        {"name": "auth", "method": "POST", "path": "/auth",
         "json_body": {"username": "admin", "password": "password123"},
         "assertions": [{"source": "status_code", "op": "equals", "expected": 200}],
         "capture": [{"name": "token", "value": "token"}]},
        {"name": "create booking", "method": "POST", "path": "/booking",
         "headers": [{"name": "Accept", "value": "application/json"}],
         "json_body": {"firstname": "Before", "lastname": "Patch", "totalprice": 140, "depositpaid": true,
                       "bookingdates": {"checkin": "2026-12-07", "checkout": "2026-12-09"}},
         "assertions": [{"source": "status_code", "op": "equals", "expected": 200}],
         "capture": [{"name": "booking_id", "value": "bookingid"}]},
        {"name": "patch first name", "method": "PATCH", "path": "/booking/{{booking_id}}",
         "headers": [{"name": "Accept", "value": "application/json"}, {"name": "Cookie", "value": "token={{token}}"}],
         "json_body": {"firstname": "After"},
         "assertions": [
           {"source": "status_code", "op": "equals", "expected": 200},
           {"source": "json", "path": "firstname", "op": "equals", "expected": "After"},
           {"source": "json", "path": "lastname", "op": "equals", "expected": "Patch"},
           {"source": "json", "path": "totalprice", "op": "equals", "expected": 140},
           {"source": "json", "path": "bookingdates.checkin", "op": "equals", "expected": "2026-12-07"}]}
      ]}
    },
    {
      "title": "Cancelling a booking returns 204 and the booking is gone",
      "requirement_ref": "AC-6.1, AC-6.2",
      "steps": ["Log in", "Create a booking", "Cancel it", "Try to fetch it"],
      "expected_result": "The cancel returns 204 No Content and the booking then returns 404.",
      "priority": "high",
      "executable": {"kind": "api", "steps": [
        {"name": "auth", "method": "POST", "path": "/auth",
         "json_body": {"username": "admin", "password": "password123"},
         "assertions": [{"source": "status_code", "op": "equals", "expected": 200}],
         "capture": [{"name": "token", "value": "token"}]},
        {"name": "create booking", "method": "POST", "path": "/booking",
         "headers": [{"name": "Accept", "value": "application/json"}],
         "json_body": {"firstname": "To", "lastname": "Cancel", "totalprice": 75, "depositpaid": false,
                       "bookingdates": {"checkin": "2026-12-14", "checkout": "2026-12-15"}},
         "assertions": [{"source": "status_code", "op": "equals", "expected": 200}],
         "capture": [{"name": "booking_id", "value": "bookingid"}]},
        {"name": "cancel booking", "method": "DELETE", "path": "/booking/{{booking_id}}",
         "headers": [{"name": "Cookie", "value": "token={{token}}"}],
         "assertions": [{"source": "status_code", "op": "equals", "expected": 204}]},
        {"name": "fetch cancelled booking", "method": "GET", "path": "/booking/{{booking_id}}",
         "assertions": [{"source": "status_code", "op": "equals", "expected": 404}]}
      ]}
    },
    {
      "title": "Single booking reads respond in under 3 seconds",
      "requirement_ref": "NFR-1",
      "steps": ["Create a booking", "Fetch it and time the response"],
      "expected_result": "The read responds in under 3000 ms.",
      "priority": "low",
      "executable": {"kind": "api", "steps": [
        {"name": "create booking", "method": "POST", "path": "/booking",
         "headers": [{"name": "Accept", "value": "application/json"}],
         "json_body": {"firstname": "Speed", "lastname": "Check", "totalprice": 1, "depositpaid": false,
                       "bookingdates": {"checkin": "2026-12-01", "checkout": "2026-12-02"}},
         "assertions": [{"source": "status_code", "op": "equals", "expected": 200}],
         "capture": [{"name": "booking_id", "value": "bookingid"}]},
        {"name": "timed read", "method": "GET", "path": "/booking/{{booking_id}}",
         "headers": [{"name": "Accept", "value": "application/json"}],
         "assertions": [
           {"source": "status_code", "op": "equals", "expected": 200},
           {"source": "elapsed_ms", "op": "less_than", "expected": 3000}]}
      ]}
    }
  ]
}
